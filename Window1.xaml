<Window x:Class="laba_3_270925.Window1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:laba_3_270925"
        mc:Ignorable="d"
        Title="Window1" Height="450" Width="900">
    <Window.Resources>
        <!-- режимы -->
        <x:Array x:Key="EditingModes" Type="InkCanvasEditingMode">
            <x:Static Member="InkCanvasEditingMode.Ink"/>
            <x:Static Member="InkCanvasEditingMode.EraseByPoint"/>
        </x:Array>

        <!-- атрибуты рисования -->
        <x:Array x:Key="DrawingAttributesArray" Type="DrawingAttributes">
            <DrawingAttributes Color="Black" Width="3" Height="3"/>
            <DrawingAttributes Color="Red" Width="5" Height="1"/>
            <DrawingAttributes Color="Green" Width="7" Height="7"/>
            <DrawingAttributes Color="Blue" Width="10" Height="10"/>
            <DrawingAttributes Color="Yellow" Width="15" Height="15"/>
            <DrawingAttributes Color="Purple" Width="20" Height="20"/>
        </x:Array>
    </Window.Resources>

    <Grid>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ToolBar Grid.Row="0" Margin="5">

            <Button Content="Назад" Margin="5,0" Click="Button_Click_close"/>
            <Button Content="Очистить экран" Margin="10,0" Click="ClearCanvas_Click"/>
            
            <Label Content="Кисть:" Margin="5,0"/>
            <ComboBox x:Name="drawingAttributesComboBox" Width="150" Margin="5,0"
                     ItemsSource="{StaticResource DrawingAttributesArray}"
                     SelectedValue="{Binding DefaultDrawingAttributes, ElementName=drawingCanvas}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Rectangle Width="20" Height="15" Margin="0,0,5,0">
                                <Rectangle.Fill>
                                    <SolidColorBrush Color="{Binding Color}"/>
                                </Rectangle.Fill>
                            </Rectangle>
                            <TextBlock Text="{Binding Color}" VerticalAlignment="Center"/>
                            <TextBlock Text=" (" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Width}" VerticalAlignment="Center"/>
                            <TextBlock Text=")" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <Label Content="Размер:" Margin="10,0,5,0"/>
            <Slider x:Name="brushSizeSlider" Width="100" Minimum="1" Maximum="50" 
                   Value="{Binding DefaultDrawingAttributes.Width, ElementName=drawingCanvas, Mode=TwoWay}"
                   TickFrequency="1" IsSnapToTickEnabled="True"/>

            <TextBlock Text="{Binding Value, ElementName=brushSizeSlider}" 
                      Width="30" Margin="5,0" TextAlignment="Center"/>

            <Separator Margin="10,0"/>
            <Label Content="Режим:" Margin="5,0"/>

            <ComboBox x:Name="editingModeComboBox" Width="150" Margin="5,0"
                     ItemsSource="{StaticResource EditingModes}"
                     SelectedValue="{Binding EditingMode, ElementName=drawingCanvas}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <TextBlock.Text>
                                <Binding>
                                    <Binding.Converter>
                                        <local:EditingModeToStringConverter/>
                                    </Binding.Converter>
                                </Binding>
                            </TextBlock.Text>
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </ToolBar>

        <!-- Холст -->
        <InkCanvas x:Name="drawingCanvas" Grid.Row="1" Margin="5"
                  Background="White" EditingMode="Ink"/>
    </Grid>
</Window>
